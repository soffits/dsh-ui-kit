{
  "name": "@soffits/dsh-ui-kit",
  "version": "0.5.0",
  "description": "Small shared pieces for DeepSeek Harness plugin pages, on top of DSH's own components: tone icon tiles, ticking countdowns and relative times, rings, sparklines and progress bars, a live dot, a short \"just changed\" wash, \"new since you looked\" dots, and the slot for suggested next steps.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-ui-kit.git"
  },
  "homepage": "https://github.com/soffits/dsh-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-ui-kit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "icons",
    "countdown",
    "live"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icons.json": "./icons.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icons.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-lucide",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@soffits/dsh-ui-actions"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check index.js && node --check client.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "esbuild": "^0.28.2",
    "lucide-static": "1.74.0"
  }
}
